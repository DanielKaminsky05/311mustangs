# Copy to `.env` and adjust. `.env` is gitignored.
PROJECT_NAME=311mustangs-api

# JSON array of allowed origins, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# Replace in every environment. Never commit a real secret.
SECRET_KEY=change-me

# --- Twilio (host-side edge service) ---
# Get from Twilio Console → Account → API keys / Project info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender: "whatsapp:+14155238886". Real WABA number once approved.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Off behind the Twilio CLI dev tunnel (URL scheme/host won't match Twilio's signature).
# Flip to true in production.
TWILIO_VALIDATE_SIGNATURE=false

# --- NemoClaw / OpenClaw intake agent ---
# Shared secret between the OpenClaw sandbox on the GX10 and this backend.
# The sandbox uses it to HMAC-sign the structured-ticket webhook body.
INTAKE_AGENT_SECRET=change-me-please-use-openssl-rand
# Where the laptop edge posts inbound WhatsApp messages to the OpenClaw agent.
# Sandbox HTTP listener inside NemoClaw — see docs/runbooks/nemoclaw-bringup.md.
SANDBOX_MESSAGE_URL=http://gx10-4a58.local:9000/messages
# Salts the sha256 of Twilio's `From` field so identical phones across deployments
# don't share a conversation key. Rotate to invalidate all stored conversations.
SENDER_HASH_SALT=change-me-too
